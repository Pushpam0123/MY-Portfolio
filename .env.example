# Contact form endpoint.
#
# Formspree:   https://formspree.io  →  create a form  →  copy the endpoint URL
# Web3Forms:   https://web3forms.com →  free, no account, emails you an access key
#
# Both are safe to expose in the client bundle — they are public submission
# endpoints, not secrets. Copy this file to `.env` and fill in the value.
#
# Leave it blank and the form gracefully degrades to a mailto: link instead.
VITE_CONTACT_ENDPOINT=

# Canonical site URL, used for SEO meta tags, sitemap, and Open Graph.
VITE_SITE_URL=https://pushpamraj.vercel.app
